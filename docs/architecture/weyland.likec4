// B64 — weyland architecture as a single LikeC4 model (source of truth). Rebuilt 2026-07-16 from the live k8s
// manifests. The two dense planes (mesh, ops) are sliced into sub-zones so each view shows a handful of
// labelled boxes to drill into, not 30 nodes at once. Powers the standalone explorer (likec4.weyland.lab)
// AND the in-page docs embeds (mkdocs-likec4).
specification {
  element actor {
    style { shape person }
  }
  element system
  element node
  element zone
  element component
  element store {
    style { shape cylinder }
  }
  element gateway
  element ext
}

model {
  edward = actor "Edward" "Lab operator — sole user"

  // ---- External clouds / SaaS ----
  telegram = ext "Telegram" "Cloud messaging — operator DMs in, alerts out"
  github = ext "GitHub" "weyland-lab repo — RAG source + Argo/Woodpecker/Port"
  anthropic = ext "Anthropic API" "Claude — Claude Code reasoning on rogueone"
  hostedModels = ext "Hosted LLM providers" "OpenAI / Anthropic / Gemini / Mistral / Cohere / DeepSeek / Together / OpenRouter / xAI — fronted by LiteLLM + the AI Gateway (gated egress)"
  huggingface = ext "Hugging Face Hub" "Model weights (bge-small, GGUF) at setup"
  port = ext "Port.io" "IDP / catalog + self-service actions (SaaS)"
  linear = ext "Linear" "Roadmap / task status (ingested by Port)"

  // ---- rogueone: external laptop, not always-on ----
  rogueone = node "rogueone" "RTX 5000 Ada laptop (.230) — GPU inference + training edge. Not always-on." {
    ollama = component "Ollama" "LLM serving — ollama.weyland.lab :11434 (moved here B79)"
    vllm = component "vLLM" "GPU inference :8000/v1"
    rayWorker = component "Ray edge worker" "Native worker — joins mother's Ray head :6379"
    genreTrainer = component "genre-trainer" "Trainer — reads silver, logs to MLflow"
    ragEmbed = component "rag-embed" "bge-small embed service :8900 (warm GPU)"
    claudeCode = component "Claude Code" "MCP client of tool-server; Claude brain"
    codingAgents = component "Coding agents" "opencode / Cline / Pi / Codex (B15) — $0 dev coding TUIs; drive hosted models DIRECT, not through the gateway"
  }

  weyland = system "weyland" "Home AI lab on a Minisforum MS-A2 (Proxmox, .232). LAN-only." {

    mother = node "mother VM" "k3s (vm-101, .243) — 64GB/12vCPU. Istio-meshed. The shared platform." {

      // ============ AI / RAG serving plane ============
      ai = zone "AI / RAG serving plane" {
        toolServer = component "weyland-tool-server" "FastAPI boundary — RAG retrieval, /context/ask, /evals, /pipeline, /mcp, guardrails"
        dagster = component "Dagster" "Orchestrator (cross-cutting) — RAG, evals, catalog, datasets, dbt, DataHub emit"
        litellm = gateway "LiteLLM" "Model gateway — Gemini + OpenRouter behind /v1 (gated egress)"
        openWebui = component "Open WebUI" "Browser voice/chat — chat -> Ollama, STT -> whisper"
        operator = component "weyland-operator" "B66 operator agent — LangGraph ReAct (gpt-oss:20b) over tool-server read+act; Telegram long-poll, Postgres session, app-level act confirm-step. Replaces Hermes."
        pg = store "Postgres + pgvector" "Spine store — rag_chunks, eval_*, model_catalog. STRICT mTLS"
        qdrant = store "Qdrant" "Vector store — weyland_chunks + 9 dataset collections"
        weav = store "Weaviate" "Vector store — WeylandChunk + 9 dataset classes"
        neo = store "Neo4j" "Graph + vector (GraphRAG) — AIDLC + music graph"
        neodash = component "NeoDash" "Neo4j dashboard / viz"
        ragIndex = component "rag-index consumers" "5 stream consumers — replay rag.chunks into each store"
      }

      // ============ Data mesh / lakehouse plane (sliced) ============
      mesh = zone "Data mesh / lakehouse plane" {

        storage = zone "Storage + catalog" {
          nessie = component "Nessie" "Iceberg REST catalog + table versioning"
          lakefs = component "lakeFS" "git-style dataset versioning; NodePort 30800"
        }

        query = zone "Query / BI / semantic" {
          trino = component "Trino" "Federation SQL — iceberg (native Nessie) + postgresql"
          gizmosql = component "GizmoSQL" "DuckDB over Arrow Flight SQL — persisted silver"
          superset = component "Superset" "BI/SQL exploration over Trino + stores"
          lightdash = component "Lightdash" "dbt-native BI over the marts"
          cube = component "Cube" "Semantic / metrics layer (SQL/REST/GraphQL)"
          dbtDocs = component "dbt Core + docs" "dbt-trino builds 7 Iceberg marts"
          trinoNoauth = component "trino-noauth proxy" "Strips auth for Lightdash / Cube"
        }

        stream = zone "Streaming" {
          redpanda = component "Redpanda" "Kafka broker + Schema Registry — datasets.* / cdc.* / rag.chunks"
          kafkaConnect = component "Kafka Connect (Debezium)" "CDC from musicbrainz-postgres -> cdc.*"
          flinkOp = component "Flink Operator" "Manages the Flink 1.20 session cluster"
          flink = component "Flink session cluster" "4 jobs — RTA, CDC, health, music -> Iceberg"
          flinkHistory = component "Flink History Server" "Archived Flink jobs"
        }

        stores = zone "Tier-2 stores" {
          clickhouse = store "ClickHouse" "Columnar OLAP — native s3() ingest"
          cassandra = store "Cassandra" "Wide-column — lastfm ~17M rows"
          cockroach = store "CockroachDB" "Distributed SQL — brfss / nhis"
          mysql = store "MySQL" "Health datasets — 6 DBs / 32 tables"
          mongodb = store "MongoDB" "Document store — who_gho, OFF, aidlc-kb"
          timescale = store "TimescaleDB" "Time-series hypertables"
          opensearch = store "OpenSearch" "Search — RAG BM25 index target"
          musicbrainz = store "MusicBrainz Postgres" "Full mbdump — CDC source"
          valkey = store "Valkey" "Shared cache — Superset / Feast online"
        }

        ml = zone "Feature store + ML" {
          feast = component "Feast server" "Feature store — registry/offline=Postgres, online=Valkey"
          feastUi = component "Feast UI" "Feast registry browser"
          mlflow = component "MLflow" "Experiment tracking + model registry (hosts the AI Gateway, B100 P4); NodePort 30500"
          aiGateway = gateway "MLflow AI Gateway" "B100 P4 — governed OpenAI-compat front door over 17 endpoints (6 local + 9 hosted + 2 judges); LLM-judge guardrails (Safety/PII, fail-closed) + $10/mo budget + tracing + eval; served by the MLflow server, NodePort 30500"
          ray = component "Ray head" "Persistent Ray cluster — rogueone joins as edge worker"
          jupyterhub = component "JupyterHub" "Notebooks — singleuser pods on-demand"
          lancedb = component "LanceDB viewer" "Embedded Lance vector store on lakeFS + UI"
        }

        gov = zone "Governance" {
          datahub = component "DataHub" "Metadata catalog + lineage + domains/products/glossaries"
          ranger = component "Apache Ranger" "Trino authz — column masking, default-deny"
          soda = component "Soda" "Data-quality contracts -> DataHub Assertions"
          storeScaler = component "store-scaler" "Scales Tier-2 stores (Port action target)"
        }
      }

      // ============ Platform / ops plane (sliced) ============
      ops = zone "Platform / ops plane" {

        edge = zone "Ingress + SSO + DNS" {
          keycloak = component "Keycloak" "Central IdP/SSO — OIDC + forward-auth for every UI"
          forwardAuth = gateway "traefik-forward-auth" "SSO gate for non-OIDC UIs"
          traefik = gateway "Traefik" "k3s ingress — TLS front door (*.weyland.lab)"
          coredns = component "CoreDNS" "LAN DNS — *.weyland.lab wildcard"
          apisix = gateway "APISIX" "API/data-plane gateway — fronts tool-server + backends"
        }

        obs = zone "Observability" {
          grafana = component "Prometheus + Grafana" "Metrics + Alertmanager -> Telegram"
          loki = component "Loki + Alloy" "Logs -> MinIO; ruler -> Alertmanager"
          tempo = component "Tempo" "Traces -> MinIO (Jaeger retired)"
          pveExporter = component "PVE exporter" "Proxmox metrics -> Prometheus"
          glitchtip = component "GlitchTip" "Error tracking -> Port"
          kuma = component "Uptime Kuma" "25 monitors -> Telegram"
          kiali = component "Kiali" "Mesh observability UI"
        }

        platform = zone "Delivery + governance" {
          argocd = component "Argo CD" "GitOps CD — app-of-apps, 28 apps"
          woodpecker = component "Woodpecker CI" "CI/CD (k8s backend)"
          gatekeeper = component "OPA Gatekeeper" "Admission control + Policy Manager"
          keda = component "KEDA" "Autoscaling / run-mode engine (on-demand stores)"
          sonarqube = component "SonarQube" "Code quality + SAST — weekly sonar-scan -> Port code_quality"
          scanSuite = component "Code scan suite" "Weekly 9-tool scan + code-maat hotspots -> Port security_scan / code_hotspot; Code Health dashboard"
          unleash = component "Unleash" "Feature flags -> Port"
          opencost = component "OpenCost" "k8s cost allocation -> Port"
          portAgent = component "Port agent" "Outbound polling — runs Port self-service actions"
        }

        infra = zone "Infra + tooling" {
          minio = store "MinIO" "S3 object storage (8TB) — warehouse/lakefs/mlflow/registry/..."
          filestash = component "Filestash" "MinIO browser UI"
          istiod = component "istiod" "Istio mesh control plane (PERMISSIVE; Postgres STRICT)"
          registry = component "Container registry" "MinIO-backed OCI registry (LAN)"
          registryUi = component "Registry UI" "Registry browser"
          headlamp = component "Headlamp" "Kubernetes UI"
          docsSite = component "docs-site" "MkDocs Material docs + Tools launchpad"
          likec4Viewer = component "LikeC4" "This architecture model viewer"
          n8n = component "n8n" "Workflow automation (ingestion retired -> Dagster)"
        }
      }
    }

    // hermes CT (CT 104) RETIRED 2026-07-23 — destroyed; operator role → weyland.mother.ai.operator
    whisper = node "whisper CT" "whisper.cpp (CT 103, .246) — CPU STT"
  }

  // ================= Relationships =================

  // Context / access
  edward -> weyland.mother.ai.openWebui "voice/chat UI"
  edward -> weyland.mother.ai.operator "Telegram DM (allowlisted)"
  edward -> rogueone.claudeCode "develops on"
  telegram -> weyland.mother.ai.operator "inbound DM"
  weyland.mother.ai.operator -> telegram "agent replies"
  weyland.mother.ops.obs.grafana -> telegram "Alertmanager notifications"
  weyland.mother.ops.obs.kuma -> telegram "uptime alerts"

  // Agents
  weyland.mother.ai.operator -> weyland.mother.ai.toolServer "read + act (/mcp, /mcp-act) — confirm-step on acts"
  weyland.mother.ai.operator -> rogueone.ollama "brain — gpt-oss:20b /v1"
  weyland.mother.ai.operator -> weyland.mother.ai.pg "session memory (STRICT mTLS)"
  rogueone.claudeCode -> weyland.mother.ai.toolServer "MCP /mcp"
  rogueone.claudeCode -> anthropic "Claude reasoning"
  edward -> rogueone.codingAgents "codes with (B15)"
  rogueone.codingAgents -> hostedModels "direct: Gemini/Mistral/OpenRouter free + ChatGPT sub (GPT-5.5) — bypasses the gateway"

  // RAG serving
  weyland.mother.ops.edge.apisix -> weyland.mother.ai.toolServer "gateway routes /context, /pipeline"
  weyland.mother.ai.toolServer -> weyland.mother.ai.pg "embed + retrieve rag_chunks"
  weyland.mother.ai.toolServer -> weyland.mother.ai.qdrant "retrieve"
  weyland.mother.ai.toolServer -> weyland.mother.ai.weav "retrieve"
  weyland.mother.ai.toolServer -> weyland.mother.ai.neo "retrieve"
  weyland.mother.ai.toolServer -> rogueone.ollama "RAG generate + eval judge /v1"
  weyland.mother.ai.toolServer -> weyland.mother.ai.litellm "hosted-model gen"
  weyland.mother.ai.litellm -> hostedModels "egress: Gemini / OpenRouter"
  weyland.mother.ai.openWebui -> rogueone.ollama "chat /v1"
  weyland.mother.ai.openWebui -> weyland.whisper "STT /v1/audio/transcriptions"
  weyland.mother.ai.neodash -> weyland.mother.ai.neo "Bolt (browser-side)"
  weyland.mother.ai.toolServer -> weyland.mother.ops.obs.glitchtip "error push (Sentry SDK)"

  // RAG streaming ingestion
  weyland.mother.ai.dagster -> github "git-pull docs/ + nodes/ (RAG source)"
  weyland.mother.ai.dagster -> rogueone.ragEmbed "chunk + embed :8900"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stream.redpanda "produce rag.chunks (Avro)"
  weyland.mother.ai.ragIndex -> weyland.mother.mesh.stream.redpanda "consume rag.chunks (5 groups)"
  weyland.mother.ai.ragIndex -> weyland.mother.ai.qdrant "upsert / delete"
  weyland.mother.ai.ragIndex -> weyland.mother.ai.weav "upsert / delete"
  weyland.mother.ai.ragIndex -> weyland.mother.ai.neo "MERGE nodes / edges"
  weyland.mother.ai.ragIndex -> weyland.mother.ai.pg "upsert rag_chunks"
  weyland.mother.ai.ragIndex -> weyland.mother.mesh.stores.opensearch "BM25 index"

  // Datasets lakehouse / hydration
  weyland.mother.ai.dagster -> weyland.mother.mesh.storage.lakefs "write bronze/silver + commit"
  weyland.mother.ai.dagster -> weyland.mother.mesh.storage.nessie "write gold Iceberg"
  weyland.mother.ai.dagster -> weyland.mother.mesh.query.dbtDocs "run dbt (7 marts)"
  weyland.mother.ai.dagster -> weyland.mother.mesh.gov.datahub "catalog emit (6h)"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.mysql "hydrate health datasets"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.clickhouse "hydrate (native s3)"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.cassandra "hydrate"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.cockroach "hydrate"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.mongodb "hydrate"
  weyland.mother.ai.dagster -> weyland.mother.mesh.stores.timescale "hourly hypertables"
  weyland.mother.mesh.stream.kafkaConnect -> weyland.mother.mesh.stores.musicbrainz "CDC -> cdc.* topics"
  weyland.mother.mesh.stream.flink -> weyland.mother.mesh.stream.redpanda "consume datasets.* / cdc.*"
  weyland.mother.mesh.stream.flink -> weyland.mother.mesh.storage.nessie "write Iceberg analytics.*"
  weyland.mother.mesh.stream.flinkOp -> weyland.mother.mesh.stream.flink "manages session cluster"

  // Query / BI / semantic
  weyland.mother.mesh.query.dbtDocs -> weyland.mother.mesh.query.trino "dbt-trino materializes marts"
  weyland.mother.mesh.query.trino -> weyland.mother.mesh.storage.nessie "iceberg catalog (native Nessie)"
  weyland.mother.mesh.query.trino -> weyland.mother.ai.pg "postgresql catalog (mesh)"
  weyland.mother.mesh.query.gizmosql -> weyland.mother.mesh.storage.lakefs "persisted DuckDB from Parquet"
  weyland.mother.mesh.query.superset -> weyland.mother.mesh.query.trino "BI queries"
  weyland.mother.mesh.query.superset -> weyland.mother.mesh.stores.valkey "Celery cache"
  weyland.mother.mesh.query.lightdash -> weyland.mother.mesh.query.trinoNoauth "dbt-native BI"
  weyland.mother.mesh.query.cube -> weyland.mother.mesh.query.trinoNoauth "semantic layer"
  weyland.mother.mesh.query.trinoNoauth -> weyland.mother.mesh.query.trino "auth-stripped hop"

  // Feature store / ML
  weyland.mother.mesh.ml.feast -> weyland.mother.ai.pg "registry + offline"
  weyland.mother.mesh.ml.feast -> weyland.mother.mesh.stores.valkey "online serving"
  rogueone.genreTrainer -> weyland.mother.mesh.storage.lakefs "read silver"
  rogueone.genreTrainer -> weyland.mother.mesh.ml.mlflow "log runs + registry :30500"
  rogueone.rayWorker -> weyland.mother.mesh.ml.ray "join cluster :6379 (token)"
  weyland.mother.mesh.ml.mlflow -> weyland.mother.ops.infra.minio "artifact store"
  weyland.mother.mesh.ml.aiGateway -> rogueone.ollama "local models (6) + guard/eval judge qwen2.5:7b /v1"
  weyland.mother.mesh.ml.aiGateway -> weyland.mother.ai.litellm "LiteLLM-routed hosted providers"
  weyland.mother.mesh.ml.aiGateway -> hostedModels "native hosted providers (gated egress)"
  weyland.mother.mesh.ml.aiGateway -> weyland.mother.mesh.ml.mlflow "usage traces + gateway-eval runs"
  weyland.mother.mesh.ml.jupyterhub -> weyland.mother.mesh.query.trino "notebook queries"

  // Governance / catalog
  weyland.mother.mesh.gov.datahub -> weyland.mother.mesh.query.trino "native source ingestion"
  weyland.mother.mesh.gov.ranger -> weyland.mother.mesh.query.trino "column masking / policy"
  weyland.mother.mesh.gov.soda -> weyland.mother.mesh.query.trino "data-quality scans"

  // Storage backends
  weyland.mother.mesh.storage.nessie -> weyland.mother.ops.infra.minio "Iceberg warehouse"
  weyland.mother.mesh.storage.lakefs -> weyland.mother.ops.infra.minio "blockstore"
  weyland.mother.ops.infra.registry -> weyland.mother.ops.infra.minio "image blobs"
  weyland.mother.ops.obs.loki -> weyland.mother.ops.infra.minio "log chunks"

  // Platform / ops
  weyland.mother.ops.edge.coredns -> weyland.mother.ops.edge.traefik "*.weyland.lab -> Traefik"
  weyland.mother.ops.edge.forwardAuth -> weyland.mother.ops.edge.keycloak "SSO gate"
  weyland.mother.ops.infra.istiod -> weyland.mother.ai.toolServer "inject Envoy sidecars"
  weyland.mother.ops.obs.grafana -> weyland.mother.ai.toolServer "scrape /metrics"
  weyland.mother.ops.obs.grafana -> rogueone.rayWorker "scrape :8080 (static target)"
  weyland.mother.ops.obs.kiali -> weyland.mother.ops.obs.grafana "Envoy mesh metrics"
  weyland.mother.ops.platform.argocd -> github "GitOps reconcile (28 apps)"
  weyland.mother.ops.platform.opencost -> weyland.mother.ops.obs.grafana "cost metrics"
  weyland.mother.ops.platform.portAgent -> port "claim action runs"
  weyland.mother.ops.platform.portAgent -> weyland.mother.mesh.gov.storeScaler "run store scale"
  port -> linear "roadmap ingest"
  weyland.mother.ai.dagster -> huggingface "model weights (setup)"
}

views {
  view index {
    title "weyland — system landscape"
    include *
  }

  view topology of weyland {
    title "weyland — node topology"
    include *
  }

  view rogueoneView of rogueone {
    title "rogueone — GPU edge"
    include *
  }

  view mother of weyland.mother {
    title "mother — the three planes"
    include *
  }

  view aiPlane of weyland.mother.ai {
    title "AI plane"
    include *
  }

  // ---- "Data mesh /" folder in the explorer nav (overview + one per sub-zone) ----
  view meshPlane of weyland.mother.mesh {
    title "Data mesh / overview"
    include *
  }
  view meshStorage of weyland.mother.mesh.storage {
    title "Data mesh / storage + catalog"
    include *
  }
  view meshQuery of weyland.mother.mesh.query {
    title "Data mesh / query + BI"
    include *
  }
  view meshStream of weyland.mother.mesh.stream {
    title "Data mesh / streaming"
    include *
  }
  view meshStores of weyland.mother.mesh.stores {
    title "Data mesh / Tier-2 stores"
    include *
  }
  view meshMl of weyland.mother.mesh.ml {
    title "Data mesh / feature store + ML"
    include *
  }
  view meshGov of weyland.mother.mesh.gov {
    title "Data mesh / governance"
    include *
  }

  // ---- "Ops /" folder in the explorer nav (overview + one per sub-zone) ----
  view opsPlane of weyland.mother.ops {
    title "Ops / overview"
    include *
  }
  view opsEdge of weyland.mother.ops.edge {
    title "Ops / ingress + SSO + DNS"
    include *
  }
  view opsObs of weyland.mother.ops.obs {
    title "Ops / observability"
    include *
  }
  view opsPlatform of weyland.mother.ops.platform {
    title "Ops / delivery + governance"
    include *
  }
  view opsInfra of weyland.mother.ops.infra {
    title "Ops / infra + tooling"
    include *
  }
}
