{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "backend": {
            "default": "pgvector",
            "title": "Backend",
            "type": "string"
          },
          "max_attempts": {
            "default": 2,
            "title": "Max Attempts",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "HTTPValidationError": {
