{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "backend": {
            "default": "pgvector",
            "title": "Backend",
            "type": "string"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "ContextSearchRequest": {
        "properties": {
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "ContextSearchRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PipelineTriggerRequest": {
        "properties": {
          "job_name": {
            "default": "weyland_ingestion_job",
            "enum": [
              "weyland_ingestion_job",
              "weyland_eval_job",
              "weyland_eval_score_job"
            ],
            "title": "Job Name",
            "type": "string"
          }
        },
        "title": "PipelineTriggerRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Weyland Tool Server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/context/ask": {
      "post": {
        "description": "RAG: retrieve top-k chunks from a backend, then have the local model synthesize a\ngrounded answer. `model` is selectable per request (defaults to OLLAMA_MODEL).",
        "operationId": "context_ask",
        "parameters": [
          {
            "in": "header",
            "name": "x-forwarded-consumer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Forwarded-Consumer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Context Ask",
        "tags": [
          "mcp"
        ]
      }
    },
    "/context/search": {
      "post": {
        "operationId": "context_search",
        "parameters": [
          {
            "in": "query",
            "name": "backend",
            "required": false,
            "schema": {
              "default": "pgvector",
              "title": "Backend",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-forwarded-consumer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Forwarded-Consumer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Context Search",
        "tags": [
          "mcp"
        ]
      }
    },
    "/evals/leaderboard": {
      "get": {
        "description": "Panel-averaged leaderboard for a run (default: the latest scored run).",
        "operationId": "evals_leaderboard_evals_leaderboard_get",
        "parameters": [
          {
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evals Leaderboard"
      }
    },
    "/evals/run": {
      "post": {
        "description": "Run the eval matrix (generate a question set + run all models). LONG-RUNNING \u2014 ~40-60 min of CPU\nand competes with the single loaded Ollama model; fire deliberately, not casually. Then POST /evals/score.",
        "operationId": "evals_run",
        "parameters": [
          {
            "in": "header",
            "name": "x-forwarded-consumer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Forwarded-Consumer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evals Run",
        "tags": [
          "mcp-act"
        ]
      }
    },
    "/evals/runs": {
      "get": {
        "description": "List recent eval runs.",
        "operationId": "evals_runs_evals_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Evals Runs"
      }
    },
    "/evals/score": {
      "post": {
        "description": "Judge-panel scoring of the latest completed matrix run. LONG-RUNNING \u2014 ~70 min of CPU. Run after\n/evals/run has completed.",
        "operationId": "evals_score",
        "parameters": [
          {
            "in": "header",
            "name": "x-forwarded-consumer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Forwarded-Consumer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evals Score",
        "tags": [
          "mcp-act"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness \u2014 is the process up? Trivial by design; backs the livenessProbe.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/models": {
      "get": {
        "description": "Models available on the Ollama endpoint, for client-side selection in /context/ask.",
        "operationId": "list_models",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "mcp"
        ]
      }
    },
    "/neo4j/health": {
      "get": {
        "operationId": "neo4j_health_neo4j_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Neo4J Health"
      }
    },
    "/ollama/health": {
      "get": {
        "operationId": "ollama_health_ollama_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ollama Health"
      }
    },
    "/pgvector/health": {
      "get": {
        "operationId": "pgvector_health_pgvector_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Pgvector Health"
      }
    },
    "/pipeline/trigger": {
      "post": {
        "description": "Trigger a Dagster job. Default (and usual choice) is `weyland_ingestion_job` \u2014 the docs/code\ningestion pipeline. `job_name` must be one of the three defined jobs; leave it at the default to\nre-ingest the knowledge base.",
        "operationId": "pipeline_trigger",
        "parameters": [
          {
            "in": "header",
            "name": "x-forwarded-consumer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Forwarded-Consumer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineTriggerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pipeline Trigger",
        "tags": [
          "mcp-act"
        ]
      }
    },
    "/qdrant/health": {
      "get": {
        "operationId": "qdrant_health_qdrant_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Qdrant Health"
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness \u2014 can we serve the core path? Gates on embed model + pgvector (the\ndefault backend) ONLY, so a single non-default backend being down does NOT pull the\nserver out of rotation. Backs the readinessProbe (503 => NotReady).",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/status": {
      "get": {
        "description": "Consolidated health \u2014 server + model + all four backends in one call.\noverall='degraded' if any backend is down (the server itself stays live/ready).",
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status",
        "tags": [
          "mcp"
        ]
      }
    },
    "/weaviate/health": {
      "get": {
        "operationId": "weaviate_health_weaviate_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Weaviate Health"
      }
    }
  }
}