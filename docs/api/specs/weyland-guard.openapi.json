    },
    "/ready": {
      "get": {
        "description": "Readiness \u2014 models loaded. 503 until the validator set is built, so traffic only arrives once the guard can\nactually score (a permanent model-load failure keeps the pod NotReady, which is correct \u2014 surface it, don't hide it).",
        "operationId": "ready_ready_get",
        "responses": {
