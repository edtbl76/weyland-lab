{
  "mcpServers": {
    "codescene": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "CS_ACCESS_TOKEN",
        "-e",
        "CS_MOUNT_PATH=/home/edwardmangini/IdeaProjects/weyland",
        "--mount",
        "type=bind,src=/home/edwardmangini/IdeaProjects/weyland,dst=/mount/,ro",
        "codescene/codescene-mcp"
      ],
      "env": {
        "CS_ACCESS_TOKEN": "${CS_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "ide-assistant",
        "--project", "/home/edwardmangini/IdeaProjects/weyland",
        "--transport", "stdio",
        "--enable-web-dashboard", "false",
        "--enable-gui-log-window", "false"
      ]
    }
  }
}