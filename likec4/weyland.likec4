// B64 — weyland architecture as a single LikeC4 model. One source of truth; the views below auto-generate the
// whole C4 hierarchy (landscape -> node topology -> mother's planes -> per-plane components). Replaces the
// cramped Mermaid C4 diagrams. Interactive pan/zoom/drill in the standalone site (likec4.weyland.lab) AND
// embedded in the docs (mkdocs-likec4). Sequence diagrams stay in Mermaid for now.
specification {
  element actor {
    style { shape person }
  }
  element system
  element node          // physical deployment unit — VM / LXC / laptop
  element zone          // logical grouping (a "plane") inside a node
  element component
  element store {
    style { shape cylinder }
  }
  element gateway
  element ext
}

model {
  edward = actor "Edward" "Lab operator — sole user"

  // External clouds / SaaS (outside the LAN)
  telegram = ext "Telegram" "Cloud messaging — Hermes DMs in, Alertmanager alerts out"
  github = ext "GitHub" "weyland-lab repo — RAG corpus source + roadmap backlog"
  hostedmodels = ext "Gemini / OpenRouter" "Free-tier hosted LLMs (via the LiteLLM gateway)"
  anthropic = ext "Anthropic API" "Claude — used by Claude Code on rogueone"
  hf = ext "Hugging Face Hub" "Model weights (bge-small + GGUF) at build / setup time"

  // rogueone is a peer node, not inside the MS-A2 box
  rogueone = ext "rogueone" "RTX 5000 Ada laptop — vLLM GPU, Claude Code, native Ray edge worker"

  weyland = system "weyland" "Home AI lab on a Minisforum MS-A2 (Proxmox, bare-metal). LAN-only." {

    mother = node "mother VM" "k3s / Kubernetes — vm-101 (.243). Istio-meshed (mTLS). The shared AI platform." {

      ai = zone "AI / RAG serving plane" "ns: weyland" {
        tool = component "weyland-tool-server" "FastAPI — RAG retrieval (4 backends), /context/ask, /evals, /pipeline, /mcp system-view"
        dag = component "Dagster" "Pipeline orchestration — RAG stream, eval, catalog (6h), datasets lakehouse"
        litellm = gateway "LiteLLM" "Hosted-model gateway — Gemini + OpenRouter behind OpenAI /v1"
        webui = component "Open WebUI" "Browser voice/chat UI — chat -> Ollama, STT -> whisper"
        pg = store "Postgres / pgvector" "Primary RAG store (rag_chunks) + eval tables + model_catalog"
        qdrant = store "Qdrant" "Vector store — weyland_chunks"
        weav = store "Weaviate" "Vector store — WeylandChunk"
        neo = store "Neo4j" "Graph + vector index (GraphRAG) — APOC + GDS"
        neodash = component "NeoDash" "Neo4j dashboard / viz UI"
        ragidx = component "rag-index consumers" "Streaming fan-out — 5 consumers replay rag.chunks into each store"
      }

      mesh = zone "Data mesh / lakehouse plane" "ns: data-mesh" {
        nessie = component "Nessie" "Iceberg catalog + git-branch table versioning"
        lakefs = component "lakeFS" "File/dataset versioning — silver written through the S3 gateway"
        trino = component "Trino" "Federation query engine — Iceberg (native Nessie) + Postgres"
        duck = component "GizmoSQL (DuckDB)" "DuckDB served over Arrow Flight SQL"
        superset = component "Superset" "BI over Trino + Postgres + Timescale + ClickHouse"
        mysql = store "MySQL" "Health datasets — 6 DBs / 32 tables"
        tsdb = store "TimescaleDB" "Time-series hypertables (metrics + who_gho series)"
        tier2 = store "Tier-2 stores" "Mongo · Cockroach · Cassandra · ClickHouse · OpenSearch · MusicBrainz-PG · Valkey"
        datahub = component "DataHub" "Metadata catalog + lineage + governance"
        redpanda = component "Redpanda" "Kafka-wire broker + schema registry (rag.chunks · datasets.* · cdc.*)"
        portaction = component "Port actions -> cluster" "port-agent (polling) -> store-scaler -> k8s scale (wake/sleep stores)"
      }

      ops = zone "Platform / ops plane" "ns: weyland + istio-system" {
        traefik = gateway "Traefik" "TLS ingress for *.weyland.lab (mkcert wildcard)"
        apisix = gateway "APISIX" "API / data-plane gateway"
        coredns = component "CoreDNS" "LAN DNS — *.weyland.lab wildcard -> Traefik"
        prom = component "Prometheus + Grafana" "Observability + Alertmanager -> Telegram"
        istiod = component "istiod" "Istio mesh control plane (PERMISSIVE; Postgres STRICT)"
        kiali = component "Kiali" "Mesh observability UI"
        mlflow = component "MLflow" "Experiment tracking + model registry (Postgres + MinIO)"
        ray = component "Ray head" "Persistent Ray cluster — training / HP-sweep jobs"
        registry = component "Container registry" "MinIO-backed OCI registry"
        minio = store "MinIO" "S3 object storage — 8TB USB passthrough"
        docs = component "Platform Docs" "MkDocs Material site — docs.weyland.lab"
        headlamp = component "Headlamp" "Kubernetes UI"
        n8n = component "n8n" "Workflow automation (ingestion role retired -> Dagster)"
      }
    }

    hermes = node "hermes CT" "Python / systemd — CT 104 (.247). Primary agent: qwen3-coder brain, MCP client, Telegram front door"
    ollama = node "ollama CT" "Ollama / llama.cpp — CT 102 (.244). CPU LLM serving, 6 GGUF models"
    whisper = node "whisper CT" "whisper.cpp + shim — CT 103 (.246). CPU speech-to-text"
    openclaw = node "openclaw VM" "DEPRIORITIZED (B28) — OpenClaw gateway, vm-100 (.169)"
  }

  // ---- Context / topology relationships ----
  edward -> weyland.mother "browser UIs (chat / dagster / grafana / superset / ...)"
  edward -> weyland.hermes "Telegram DM (allowlisted)"
  edward -> rogueone "develops on / operates from"
  telegram -> weyland.hermes "inbound DM delivery"
  weyland.hermes -> telegram "agent replies"
  weyland.mother -> telegram "Alertmanager notifications"
  rogueone -> anthropic "Claude Code reasoning brain"

  // ---- hermes / CT relationships ----
  weyland.hermes -> weyland.mother.ai.tool "system-view MCP /mcp (read-only)"
  weyland.hermes -> weyland.mother.ai.litellm "planning turns /v1 (Gemini-free)"
  weyland.hermes -> weyland.mother.ollama "LLM inference /v1 (reasoning)"
  weyland.hermes -> github "roadmap-sync pulls backlog.md (6h)"
  rogueone -> weyland.mother.ai.tool "Claude Code MCP /mcp (read-only)"
  rogueone -> weyland.mother.ops.ray "native Ray worker joins; jobs submitted"
  rogueone -> weyland.mother.ops.mlflow "log runs + artifacts (direct to MinIO)"

  // ---- AI / RAG serving plane ----
  weyland.mother.ai.tool -> weyland.mother.ai.pg "embed + retrieve rag_chunks"
  weyland.mother.ai.tool -> weyland.mother.ai.qdrant "retrieve"
  weyland.mother.ai.tool -> weyland.mother.ai.weav "retrieve"
  weyland.mother.ai.tool -> weyland.mother.ai.neo "retrieve"
  weyland.mother.ai.tool -> weyland.mother.ollama "RAG generate + eval judge /v1"
  weyland.mother.ai.tool -> weyland.mother.ai.dag "POST /pipeline/trigger"
  weyland.mother.ai.litellm -> hostedmodels "egress: Gemini / OpenRouter"
  weyland.mother.ai.webui -> weyland.mother.ollama "chat completions /v1"
  weyland.mother.ai.webui -> weyland.mother.whisper "STT /v1/audio/transcriptions"
  weyland.mother.ai.neodash -> weyland.mother.ai.neo "Bolt (browser-side)"
  weyland.mother.ai.dag -> github "git-pull docs/ + nodes/ (RAG source)"
  weyland.mother.ai.dag -> weyland.mother.mesh.redpanda "publish rag.chunks (Avro)"
  weyland.mother.ai.ragidx -> weyland.mother.mesh.redpanda "consume rag.chunks (5 groups)"
  weyland.mother.ai.ragidx -> weyland.mother.ai.qdrant "upsert / delete"
  weyland.mother.ai.ragidx -> weyland.mother.ai.weav "upsert / delete"
  weyland.mother.ai.ragidx -> weyland.mother.ai.neo "MERGE nodes / edges"
  weyland.mother.ai.ragidx -> weyland.mother.ai.pg "upsert rag_documents / rag_chunks"
  weyland.mother.ai.ragidx -> weyland.mother.mesh.tier2 "OpenSearch BM25 index"

  // ---- Data mesh / lakehouse plane ----
  weyland.mother.ai.dag -> weyland.mother.mesh.lakefs "write silver (parquet/arrow/avro/lance) + commit"
  weyland.mother.ai.dag -> weyland.mother.mesh.nessie "hydrate Iceberg gold"
  weyland.mother.ai.dag -> weyland.mother.mesh.mysql "hydrate health datasets"
  weyland.mother.ai.dag -> weyland.mother.mesh.tsdb "hourly hypertables"
  weyland.mother.ai.dag -> weyland.mother.mesh.tier2 "hydrate Tier-2 stores"
  weyland.mother.ai.dag -> weyland.mother.mesh.datahub "catalog emit (6h)"
  weyland.mother.mesh.trino -> weyland.mother.mesh.nessie "iceberg catalog (native Nessie)"
  weyland.mother.mesh.superset -> weyland.mother.mesh.trino "primary query engine"
  weyland.mother.mesh.duck -> weyland.mother.mesh.lakefs "materialize tables from Parquet"
  weyland.mother.mesh.nessie -> weyland.mother.ops.minio "Iceberg warehouse"
  weyland.mother.mesh.lakefs -> weyland.mother.ops.minio "blockstore"

  // ---- Platform / ops plane ----
  weyland.mother.ops.mlflow -> weyland.mother.ops.minio "artifact store (big models direct)"
  weyland.mother.ops.registry -> weyland.mother.ops.minio "image blobs"
  weyland.mother.ops.istiod -> weyland.mother.ai.tool "injects Envoy sidecars"
  weyland.mother.ops.prom -> weyland.mother.ai.tool "scrape /metrics + ServiceMonitors"
  weyland.mother.ops.apisix -> weyland.mother.ai.tool "gateway routes: /context, /pipeline"
  weyland.mother.ops.coredns -> weyland.mother.ops.traefik "*.weyland.lab wildcard resolution"
  weyland.mother.ops.kiali -> weyland.mother.ops.prom "Envoy mesh metrics"
}

views {
  view index {
    title "weyland — system landscape"
    include *
  }

  view topology of weyland {
    title "weyland — node topology (MS-A2)"
    include *
  }

  view mother of weyland.mother {
    title "mother VM — the three planes"
    include *
  }

  view aiPlane of weyland.mother.ai {
    title "AI / RAG serving plane"
    include *
  }

  view meshPlane of weyland.mother.mesh {
    title "Data mesh / lakehouse plane"
    include *
  }

  view opsPlane of weyland.mother.ops {
    title "Platform / ops plane"
    include *
  }
}
