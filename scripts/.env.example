# Top-level local env for repo scripts. Copy to `scripts/.env` (GITIGNORED) and fill in only what you have.
# NEVER commit the filled-in .env. Scripts that call _load_dotenv auto-load this (walk up to <repo>/scripts/.env) —
# no sourcing, no navigating the nodes/ tree. Real process env always wins.

# --- register_gateway_endpoints.py (B100 P4 — MLflow AI Gateway) ---
# For a LOCAL run, port-forward the `mlflow` svc :5000 to localhost first (the gateway API has no auth at the pod).
MLFLOW_GATEWAY_API=http://localhost:5000
OLLAMA_OPENAI_BASE=http://192.168.1.230:11434/v1   # Ollama base MUST include /v1

# Hosted providers — set ONLY the ones you have a key for; each creates <provider>-<model> endpoint(s).
# *_MODELS is optional (comma-separated) and overrides the default model per provider.
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-haiku-4-5
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
LITELLM_API_KEY=
# LITELLM_MODELS=
# LITELLM_BASE=http://litellm.weyland.svc.cluster.local:4000/v1
