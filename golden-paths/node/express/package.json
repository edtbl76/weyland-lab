{
  "name": "golden-node-express",
  "version": "1.0.0",
  "private": true,
  "description": "Golden path — Node/Express (B153; deep contract v2, B262). zod validation, error middleware, request-id + access log + per-route metrics, OTel. Tested via jest + supertest.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/shared/items-backends.js"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "express": "^4.21.2",
    "prom-client": "^15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "eslint": "^9.18.0",
    "ioredis": "6.0.0",
    "jest": "^29.7.0",
    "kafkajs": "2.2.4",
    "license-checker": "^25.0.1",
    "pg": "8.23.1",
    "supertest": "^7.0.0"
  }
}
