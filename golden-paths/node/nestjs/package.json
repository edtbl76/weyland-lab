{
  "name": "golden-node-nestjs",
  "version": "1.0.0",
  "private": true,
  "description": "Golden path — Node/NestJS (B153; deep contract v2, B262). TypeScript; ValidationPipe + class-validator, exception filter, middleware, providers, @nestjs/swagger OpenAPI, OTel. Tested via @nestjs/testing + supertest (jest/ts-jest).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.8",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "ioredis": "6.0.0",
    "jest": "^29.7.0",
    "kafkajs": "2.2.4",
    "license-checker": "^25.0.1",
    "pg": "8.23.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "brace-expansion@^5.0.12": "5.0.12",
    "@isaacs/nonrecursive-glob-match": "1.0.2",
    "multer": "2.5.0"
  }
}
