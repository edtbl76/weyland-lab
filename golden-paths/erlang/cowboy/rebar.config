%% Golden path — Erlang / Cowboy. rebar3 project.
%% Test:      rebar3 eunit                 (4 contract tests over a live Cowboy listener)
%% Selfcheck: rebar3 as selfcheck eunit     (adds selfcheck/ — a deliberate failure; MUST exit non-zero)
%% Release:   rebar3 release                (self-contained, bundles ERTS → _build/prod/rel/golden_cowboy)
{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"}
]}.

{relx, [
    {release, {golden_cowboy, "1.0.0"}, [golden_cowboy]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true}
]}.

%% The deliberate selfcheck lives in selfcheck/ and is compiled ONLY under this profile, so a plain
%% `rebar3 eunit` never sees it (mirrors the go exemplar's `deliberate` build tag). `rebar3 as selfcheck
%% eunit` adds it and the run exits non-zero — proving the lane propagates failure.
{profiles, [
    {selfcheck, [
        {extra_src_dirs, [{"selfcheck", [{recursive, true}]}]},
        %% eunit's app-level discovery does not scan extra_src_dirs, so name the module explicitly:
        %% the selfcheck run executes the deliberate test (and fails closed), never zero tests.
        {eunit_tests, [{module, golden_cowboy_selfcheck_tests}]}
    ]}
]}.
