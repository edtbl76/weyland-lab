    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
