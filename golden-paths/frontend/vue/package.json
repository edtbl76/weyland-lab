{
  "name": "golden-frontend-vue",
  "version": "1.0.0",
  "private": true,
  "description": "Golden path — Frontend/Vue3+Vite (B160). SPA built by Vite; contract endpoints (/health /ready /metrics /hello) via a tiny stdlib static server; the demo route renders <Hello/>. Tested via vitest + @vue/test-utils.",
  "scripts": {
