{
  "name": "golden-frontend-react-router",
  "version": "1.0.0",
  "private": true,
  "description": "Golden path \u2014 Frontend/React Router (B153; was Remix until 2026-10-27). React SSR via React Router framework mode + Vite; contract endpoints (/health /ready /metrics /hello) as resource routes + an SSR-rendered demo route. Tested via jest + testing-library.",
  "scripts": {
    "start": "react-router-serve ./build/server/index.js",
    "build": "react-router build",
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "collectCoverageFrom": [
      "app/components/**/*.tsx",
      "app/lib/greeting.ts"
    ]
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "isbot": "^5.1.20",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@react-router/dev": "^8.5.0",
    "@react-router/fs-routes": "^8.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "toml": "5.0.1"
  }
}
