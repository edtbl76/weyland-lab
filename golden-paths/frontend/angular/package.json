{
  "name": "golden-frontend-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Golden path \u2014 Frontend/Angular (B160). SPA built by ng build; contract endpoints (/health /ready /metrics /hello) via a tiny stdlib static server; demo route renders the greeting. Tested via jest (headless, on the pure greeting logic).",
  "scripts": {
    "ng": "ng",
