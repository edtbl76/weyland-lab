{
  "name": "golden-frontend-remix",
  "version": "1.0.0",
  "private": true,
  "description": "Golden path — Frontend/Remix (B153). React SSR via Remix + Vite; contract endpoints (/health /ready /metrics /hello) as resource routes + an SSR-rendered demo route. Tested via jest + testing-library.",
  "scripts": {
    "start": "remix-serve ./build/server/index.js",
    "build": "remix vite:build",
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            ["@babel/preset-env", { "targets": { "node": "current" } }],
            ["@babel/preset-react", { "runtime": "automatic" }],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "collectCoverageFrom": ["app/components/**/*.tsx", "app/lib/greeting.ts"]
  },
  "dependencies": {
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "isbot": "^5.1.20",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@remix-run/dev": "^2.15.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "babel-jest": "^29.7.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7"
  }
}
