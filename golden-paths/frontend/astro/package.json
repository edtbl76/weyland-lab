{
  "name": "golden-frontend-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Golden path — Frontend/Astro (B153). SSR via @astrojs/node; contract endpoints (/health /ready /metrics /hello) as Astro endpoints + an SSR-rendered demo page. Tested via jest + ts-jest at the module/endpoint layer.",
  "scripts": {
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build",
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        { "tsconfig": { "module": "commonjs", "esModuleInterop": true, "verbatimModuleSyntax": false } }
      ]
    },
    "collectCoverageFrom": ["src/lib/**/*.ts", "src/pages/**/*.ts"]
  },
  "dependencies": {
    "@astrojs/node": "^9.1.0",
    "astro": "^5.1.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
