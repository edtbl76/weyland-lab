{
  "name": "weyland-fixture-react",
  "private": true,
  "description": "Hello-world fixture for the React lane (B88). Unlike the TypeScript/JavaScript lanes this one CANNOT be dependency-free: rendering a component needs React itself plus a DOM, so it carries jest + testing-library + jsdom. jest (not vitest) matches the production convention in STUD.io's roadie.",
  "scripts": {
    "test": "jest --testPathIgnorePatterns /node_modules/ /selfcheck/",
    "test:selfcheck": "jest selfcheck --testPathIgnorePatterns /node_modules/"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "@babel/preset-env",
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
