# B130 — rogueone backup secrets. Copy to `.env` (gitignored) and fill in. NEVER commit real values.
#   cp .env.example .env  &&  ${EDITOR:-nano} .env
#
# TWO ways to provide the four restic vars — pick one:
#
# (A) Central (recommended) — keep them in the shared scripts/.env (single source of truth), and make
#     .env a one-liner that sources it:
#       . /home/edwardmangini/IdeaProjects/weyland/scripts/.env
#
# (B) Standalone — set them inline here. RESTIC_PASSWORD encrypts the repo: lose it and the backup is
#     UNRECOVERABLE — escrow it in a password manager, never only on this box. AWS_* are the MinIO
#     keys (same as the `weyland` mc alias).
export RESTIC_REPOSITORY="s3:http://192.168.1.243:30990/rogueone-backup"
export RESTIC_PASSWORD="CHANGEME-long-random-passphrase"
export AWS_ACCESS_KEY_ID="CHANGEME-minio-access-key"
export AWS_SECRET_ACCESS_KEY="CHANGEME-minio-secret-key"
