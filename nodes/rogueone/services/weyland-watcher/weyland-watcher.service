[Unit]
Description=Weyland file watcher — triggers Dagster ingestion on weyland.md change
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/weyland-watcher/env
ExecStart=/usr/bin/python3 %h/.local/lib/weyland-watcher/watcher.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
