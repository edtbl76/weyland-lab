# B211 (2026-10-22) — the Ollama front door on rogueone: nginx in Docker (host network) in front of an Ollama bound to
# 127.0.0.1. Config: nodes/rogueone/ollama-proxy/ (mounted read-only from this repo). The token map lives outside git
# at /etc/ollama-proxy-secret/token.map (root, 0600), written from scripts/.env by the runbook command.
#   Install:  sudo install -m 0644 nodes/rogueone/systemd/ollama-proxy.service /etc/systemd/system/ollama-proxy.service
#             sudo systemctl daemon-reload && sudo systemctl enable --now ollama-proxy
#   Check:    systemctl status ollama-proxy · journalctl -u ollama-proxy  (access log: status codes, never the token)
# Runbook: docs/runbooks/model-serving-ollama.md § Front door. Test: nodes/rogueone/ollama-proxy/test-proxy.sh.
[Unit]
Description=Ollama front door — bearer token for remote callers (B211)
After=docker.service ollama.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Environment=NGINX_IMAGE=nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
Environment=CONF=/home/edwardmangini/IdeaProjects/weyland/nodes/rogueone/ollama-proxy
ExecStartPre=-/usr/bin/docker rm -f ollama-proxy
ExecStart=/usr/bin/docker run --rm --name ollama-proxy --network host \
  -v ${CONF}/nginx.conf:/etc/nginx/nginx.conf:ro -v ${CONF}:/etc/ollama-proxy:ro \
  -v /etc/ollama-proxy-secret/token.map:/run/secrets/ollama-proxy-token.map:ro ${NGINX_IMAGE}
ExecStop=/usr/bin/docker stop ollama-proxy
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
