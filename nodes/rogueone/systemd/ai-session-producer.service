# B69 Wave 4 — codify the ai_session producer (B62 AI-Dev Usage data product). Was an uncommitted rogueone
# crontab entry: nothing in git recreated it, so a rebuilt/reimaged workstation would silently stop feeding the
# data product and the Port dashboard would just quietly flatline.
#
# Pipeline: ai_session_feeder.py parses local Claude Code telemetry into ~/.cache/ai-sessions/, then `mc mirror`
# uploads it to the `ai-sessions` bucket, where the Dagster `ai_session` job ingests it.
#
# USER unit, not system: `mc` reads its alias/credentials from ~/.mc (the `weyland` alias), and the script reads
# the caller's ~/.cache. Running it as root would find neither.
#   Install:  systemctl --user daemon-reload && systemctl --user enable --now ai-session-producer.timer
#   REQUIRED: loginctl enable-linger edwardmangini   <- without this the timer only runs while logged in,
#             which reintroduces exactly the silent-gap problem this unit exists to remove.
#
# The `&&` is deliberate (preserved from the crontab): if the feeder fails, do NOT mirror — better to upload
# nothing than to publish a half-written batch to the bucket the data product reads.
[Unit]
Description=AI-Dev Usage producer — parse Claude Code sessions, mirror to MinIO
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# B185 (2026-10-13): then push time per issue to Port (issue_time entities, read back, + the Time per Issue dashboard).
# B185 lane 2 (2026-10-15): before that, owner_time.py adds the owner's own time (ActivityWatch + Clockify; the Clockify
# key is read from ONLY its line of scripts/.env). An owner-time failure does not stop the agent-time push (the last
# owner_time.json, true but older, is used), but it still fails the unit.
# A failure fails this unit, which the nightly machine-inv-drift placement check reports to Kuma (failed unit).
ExecStart=/bin/bash -c 'S=/home/edwardmangini/IdeaProjects/weyland; /usr/bin/python3 $S/nodes/mother/lab/weyland-platform/scripts/ai_session_feeder.py && "$(command -v mc)" mirror --overwrite /home/edwardmangini/.cache/ai-sessions/ weyland/ai-sessions/ || exit 1; /usr/bin/python3 $S/nodes/mother/lab/weyland-platform/scripts/owner_time.py --env-file $S/scripts/.env; o=$?; /bin/bash $S/scripts/issue-time.sh --port; i=$?; [ "$o" -eq 0 ] && [ "$i" -eq 0 ]'
# Journald instead of the old >> ~/.cache/ai-session-producer.log: an unrotated append-only logfile grows
# forever, and `journalctl --user -u ai-session-producer` gives per-run exit status the flat file never did.
StandardOutput=journal
StandardError=journal
