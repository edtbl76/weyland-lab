# Operator creds for the scripts in this dir (SEC-1). Copy to `.env` — which is GITIGNORED — fill in, and source
# it once per shell before running any of them:
#
#   set -a; . ./.env; set +a
#
# The scripts have NO baked-in password fallback any more: if a var below is unset they fail loudly instead of
# silently connecting with a hardcoded credential. Values = the shared lab dev cred (docs/runbooks/secrets.md).
# Same convention as services/weyland-apisix/.env.example. Never commit the filled-in .env.

# superset_seed.py · superset_seed_cube.py · superset_seed_extra.py · superset_bulk_clickhouse.py
SUPERSET_PASSWORD=

# superset_bulk_clickhouse.py
CLICKHOUSE_PASSWORD=

# ranger_setup.py — Ranger UI users require upper+lower+digit, so this is NOT the plain shared cred
RANGER_ADMIN_PASSWORD=

# --- register_gateway_endpoints.py (B100 P4 — MLflow AI Gateway) ---
# For a LOCAL run, port-forward the `mlflow` svc :5000 to localhost first (gateway API has no auth at the pod).
MLFLOW_GATEWAY_API=http://localhost:5000
OLLAMA_OPENAI_BASE=http://192.168.1.230:11434/v1
# Hosted providers — set ONLY the ones you have a key for; each creates <provider>-<model> endpoint(s).
# *_MODELS is optional (comma-separated) and overrides the default model per provider.
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-haiku-4-5
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
LITELLM_API_KEY=
# LITELLM_MODELS=
# LITELLM_BASE=http://litellm.weyland.svc.cluster.local:4000/v1
