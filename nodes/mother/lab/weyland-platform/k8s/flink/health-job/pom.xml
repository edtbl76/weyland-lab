<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- B83 Job 3 - Java DataStream (health). Shaded fat jar: the Kafka connector + Confluent-Avro registry format
       are NOT on the Flink dist classpath (the image ships the SQL fat jars, which relocate those classes), so a
       DataStream job must bundle them. flink-streaming-java stays provided (in the dist). -->
  <groupId>lab.weyland</groupId>
  <artifactId>flink-health-job</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flink.version>1.20.1</flink.version>
    <kafka.connector.version>3.3.0-1.20</kafka.connector.version>
  </properties>

  <repositories>
    <!-- flink-avro-confluent-registry pulls io.confluent:kafka-schema-registry-client (not on Maven Central). -->
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- DeliveryGuarantee + connector base classes; the kafka connector declares this provided, so pull it
           explicitly for compile. It's in the Flink dist at runtime. -->
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${kafka.connector.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-avro-confluent-registry</artifactId>
      <version>${flink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-avro</artifactId>
      <version>${flink.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>health-job</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- The Flink dist ships flink-sql-avro-confluent-registry in /opt/flink/lib for the SQL jobs; it
                   contains the SAME org.apache.flink.formats.avro.* classes but with Avro shaded. Flink loads
                   org.apache.flink.* PARENT-FIRST (classloader.parent-first-patterns.default), so the dist copy
                   shadows ours and forGeneric(org.apache.avro.Schema, String) is NoSuchMethod (its Schema is the
                   shaded type). Relocate our copy to a private package so there is no name collision and our
                   plain-Avro version loads. org.apache.avro stays un-relocated: the dist has no plain Avro on its
                   parent classpath, so it loads child-first from this jar with no conflict. -->
              <relocations>
                <relocation>
                  <pattern>org.apache.flink.formats.avro</pattern>
                  <shadedPattern>lab.weyland.shaded.flinkavro</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>lab.weyland.flink.HealthStateRisk</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
