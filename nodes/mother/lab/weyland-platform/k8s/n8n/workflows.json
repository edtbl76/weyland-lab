        "name": "Read Weyland Note",
        "credentials": {
          "sshPrivateKey": {
            "id": "AW27RC3wfkXliXwu",
            "name": "SSH Weyland Lab"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const item = $input.first().json;\n\n// n8n SSH output is usually in stdout.\n// Keep fallbacks so we can inspect if the shape differs.\nconst markdown =\n  item.stdout ??\n  item.data ??\n  item.output ??\n  JSON.stringify(item, null, 2);\n\nreturn [\n  {\n    json: {\n      name: \"weyland.md\",\n      source_type: \"obsidian\",\n      source_path: \"/home/edwardmangini/Documents/ObsidianVault/Projects/weyland/weyland.md\",\n      markdown,\n      length: markdown.length,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          416,
          0
        ],
        "id": "1108e6b6-9a85-457e-98eb-0da7b40fa78f",
        "name": "Extract Markdown Text"
      },
      {
        "parameters": {
          "jsCode": "const item = $input.first().json;\nconst markdown = item.markdown || \"\";\n\nconst sections = markdown\n  .split(/\\n(?=## )/g)\n  .map((section, index) => {\n    const titleMatch = section.match(/^##\\s+(.+)$/m);\n    const title = titleMatch ? titleMatch[1].trim() : index === 0 ? \"Preamble\" : `Section ${index}`;\n\n    return {\n      name: item.name,\n      source_type: item.source_type,\n      source_path: item.source_path,\n\n      current_hash: item.current_hash,\n      previous_hash: item.previous_hash,\n      should_ingest: item.should_ingest,\n\n      chunk_index: index,\n      chunk_title: title,\n      content: section.trim(),\n      metadata: {\n        title,\n        source: item.source_path,\n      },\n    };\n  })\n  .filter(chunk => chunk.content.length > 0);\n\nreturn sections.map(chunk => ({ json: chunk }));"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1376,
          -16
        ],
        "id": "36a08c9e-04ba-4b23-a5b6-7530e453e6cc",
        "name": "Chunk Markdown"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://192.168.1.243:30080/context/ingest",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          1744,
          -16
        ],
        "id": "901bdb92-ae34-409a-9c14-ecaec902d440",
        "name": "Ingest Weyland Context"
      },
      {
        "parameters": {
          "jsCode": "const chunks = $input.all().map(item => item.json);\nconst first = chunks[0] || {};\n\nconst cleanedChunks = chunks.map(chunk => ({\n  name: chunk.name,\n  source_type: chunk.source_type,\n  source_path: chunk.source_path,\n  chunk_index: chunk.chunk_index,\n  chunk_title: chunk.chunk_title,\n  content: chunk.content,\n  metadata: chunk.metadata || {},\n}));\n\nreturn [\n  {\n    json: {\n      name: \"weyland.md\",\n      source_type: \"obsidian\",\n      source_path: \"/home/edwardmangini/Documents/ObsidianVault/Projects/weyland/weyland.md\",\n      content_hash: first.current_hash,\n      chunks: cleanedChunks,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
