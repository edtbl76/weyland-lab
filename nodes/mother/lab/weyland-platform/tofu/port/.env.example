# Template for tofu/port/.env (which is gitignored). Copy, fill in, then:  source .env && tofu plan
#
# Port credentials — use the ORGANIZATION creds (Port → Credentials → Organization tab), NOT Personal.
# Personal creds authenticate + manage the catalog but 403 on the execution agent's claim-pending calls.
export PORT_CLIENT_ID='<org-client-id>'
export PORT_CLIENT_SECRET='<org-client-secret>'

# MinIO S3 backend for tofu state (s3.weyland.lab).
export AWS_ACCESS_KEY_ID='admin'
export AWS_SECRET_ACCESS_KEY='<minio-secret>'
