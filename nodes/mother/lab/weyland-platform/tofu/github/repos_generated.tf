# B138 — the active repos other than weyland-lab (7 at B138; OJayFloyd and grkit since), codified in IaC. Generated by `tofu plan -generate-config-out` from the
# LIVE repos (accurate, not hand-guessed — B137 lesson), then cleaned: the experimental generator emits
# read-only/create-only cruft (etag, fork, gitignore_template, license_template, source_owner, source_repo,
# archive_on_destroy) that was stripped here — same fields repo.tf drops for weyland_lab. etag especially MUST
# go: it changes on every repo change, so keeping it makes every plan perpetually dirty and defeats drift
# detection. `vulnerability_alerts = true` (deprecated, like repo.tf's B89 line) states the live setting: omitting it
# made trivy report GIT-0003 "alerts disabled" on every repo here while all of them had alerts on (verified 204,
# 2026-10-14). The deprecation warning is cosmetic; github_repository_vulnerability_alerts is invisible to trivy.

resource "github_repository" "Algopedia" {
  name                        = "Algopedia"
  visibility                  = "public"
  vulnerability_alerts        = true
  allow_auto_merge            = false
  allow_forking               = true
  allow_merge_commit          = true
  allow_rebase_merge          = true
  allow_squash_merge          = true
  allow_update_branch         = false
  archived                    = false
  auto_init                   = false
  delete_branch_on_merge      = false
  has_discussions             = false
  has_issues                  = true
  has_projects                = true
  has_wiki                    = true
  is_template                 = false
  merge_commit_message        = "PR_TITLE"
  merge_commit_title          = "MERGE_MESSAGE"
  squash_merge_commit_message = "COMMIT_MESSAGES"
  squash_merge_commit_title   = "COMMIT_OR_PR_TITLE"
  topics                      = []
  web_commit_signoff_required = false
  security_and_analysis {
    secret_scanning { status = "disabled" }
    secret_scanning_push_protection { status = "disabled" }
  }
}

