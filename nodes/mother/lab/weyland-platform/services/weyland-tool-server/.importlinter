# Architecture contracts for weyland-tool-server (B152 — architecture test category).
#
# guardrails/ here is the verdict.py wire contract SHARED byte-for-byte with weyland-guard (guarded for drift by
# weyland-guard/tests/test_verdict_contract.py). It is pure enums + a dataclass and MUST stay framework-free: a
# fastapi/starlette import in verdict.py would force the web framework onto every consumer of the shared type
# (both this server and weyland-guard). main.py is the only layer that wires it to HTTP.
#
# Enforced by import-linter (grimp static AST analysis — runs in the slim lane with only import-linter
# installed). tests/test_architecture.py runs this config (expects PASS) AND a planted-violation config
# (expects BROKEN by name), proving the rule catches a real violation, not merely that it loads.

[importlinter]
root_package = guardrails
include_external_packages = True

[importlinter:contract:guardrails-are-framework-free]
name = guardrails (the shared verdict wire contract) must not import the web framework
type = forbidden
source_modules =
    guardrails
forbidden_modules =
    fastapi
    starlette
