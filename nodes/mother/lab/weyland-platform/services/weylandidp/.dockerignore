# Tuned for the MULTI-STAGE Dockerfile (builds from source inside Docker), so — unlike the create-app
# default — packages/*/src and plugins are KEPT (the build stage needs them). We still drop the heavy /
# host-only / secret bits so the build context stays small and reproducible.
.git
node_modules
**/node_modules
.yarn/cache
.yarn/install-state.gz
dist
dist-types
packages/*/dist
*.local.yaml
*-credentials.yaml
.env
.env.*
coverage
e2e-test-report
