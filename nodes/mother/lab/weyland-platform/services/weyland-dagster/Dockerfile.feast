# Slim Feast feature-server image — just feast + the repo, NOT the fat dagster stack (torch/sentence-transformers/
# the baked bge model), which OOM'd `feast serve` at 512Mi and is wasteful for a REST server. ~300MB.
# Build + import on mother (like redeploy.sh):
#   docker build -f Dockerfile.feast -t feast-server:local .
#   docker save feast-server:local | sudo ctr -n k8s.io images import -
FROM python:3.11-slim
WORKDIR /app
# grpc*: `feast ui` (0.58 REST mode) imports feast.registry_server, which pulls the full gRPC registry-server
# stack (grpc + grpc_health + grpc_reflection) that feast[redis,postgres] omits (feast serve doesn't need it,
# feast ui does). Harmless to feast-server; shared image stays single-source.
RUN pip install --no-cache-dir "feast[redis,postgres]" grpcio grpcio-health-checking grpcio-reflection
COPY feast_repo/ ./feast_repo/
EXPOSE 6566
CMD ["feast", "-c", "/app/feast_repo", "serve", "-h", "0.0.0.0", "-p", "6566"]
