conf:
  listen:
    host: 0.0.0.0
    port: 9000
  etcd:
    endpoints:
      - "http://weyland-apisix-etcd:2379"
  log:
    error_log:
      level: warn
    access_log:
      file_path: /dev/stdout

authentication:
  secret: ${APISIX_DASHBOARD_SECRET}
  expire_time: 3600
  users:
    - username: admin
      password: ${APISIX_DASHBOARD_PASSWORD}
