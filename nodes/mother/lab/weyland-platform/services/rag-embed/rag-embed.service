# rag-embed — warm GPU embedding service on rogueone (native systemd, sibling to ray-worker.service).
# Deploy: rsync services/rag-embed/ to rogueone:~/rag-embed/, build the venv, then enable this unit.
# Reached from the k8s producer over the LAN at http://rogueone.weyland.lab:8900 (add to LAN DNS if absent).
[Unit]
Description=weyland RAG embedding service (bge-base 768-dim, GPU) — B74
After=network-online.target
Wants=network-online.target

[Service]
User=edwardmangini
WorkingDirectory=/home/edwardmangini/rag-embed
Environment=EMBED_MODEL=BAAI/bge-base-en-v1.5
Environment=EMBED_DEVICE=cuda
Environment=EMBED_BATCH_SIZE=64
ExecStart=/home/edwardmangini/rag-embed/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
