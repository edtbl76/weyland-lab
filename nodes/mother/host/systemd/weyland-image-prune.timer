# Weekly trigger for weyland-image-prune.service. Sun 00:15 America/New_York, pinned to NY in the spec (mother's host
# clock is UTC — Design Rule #1). Moved 2026-09-29 (B180) from Sun 15:00 UTC = 11:00 NY, a mid-day slot Design Rule
# #5 forbids; now beside its sibling weyland-docker-prune (00:10), before the 00:20 `timeseries`. Jitter 2 min so it
# cannot reach 00:20. Persistent = catch-up if the box was off at fire time.
[Unit]
Description=Weekly k3s/containerd image prune

[Timer]
OnCalendar=Sun 00:15 America/New_York
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
