# Fires every 60s. Pair with a Kuma Push monitor set to a 120s heartbeat interval: one missed run is
# tolerated (a restart, a slow boot), two consecutive misses page. Tighter than that and a routine
# `systemctl restart hermes-gateway` would alert.
# OnBootSec gives the gateway time to come up before the first probe, so a reboot doesn't self-page.
[Unit]
Description=Run the Hermes liveness heartbeat every minute

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
