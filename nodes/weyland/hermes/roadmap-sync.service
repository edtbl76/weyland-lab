# B69 Wave 4 — codify the roadmap-sync trigger (was manual-only). Mirrors docs/backlog.md (fetched raw from
# the public repo) into the Hermes `weyland-roadmap` Kanban board. One-way and idempotent: re-running updates
# status rather than creating duplicates, so a missed or doubled run is harmless — which is exactly what makes
# it safe to put on a timer unattended.
#
# The script fetches over the internet (raw.githubusercontent.com), so it needs network-online, not just
# network. It is a TRACKING MIRROR: every item is parked `blocked` so the board dispatcher never spawns a
# worker off a backlog line.
[Unit]
Description=Sync docs/backlog.md -> Hermes weyland-roadmap board
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/root/hermes/roadmap-sync.py
WorkingDirectory=/root/hermes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
User=root

[Install]
WantedBy=multi-user.target
