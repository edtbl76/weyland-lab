#!/home/emangini/.venvs/weyland/bin/python
import sys
import psycopg2
from sentence_transformers import SentenceTransformer

MODEL_NAME = "BAAI/bge-small-en-v1.5"

def help_text():
    print("""weyland-semantic-search

Searches Weyland RAG chunks using pgvector semantic similarity.

Usage:
  weyland-semantic-search <query>
  weyland-semantic-search help

Examples:
  weyland-semantic-search "what model is rogueone serving"
  weyland-semantic-search "Claude auth problem"
""")

def main():
    if len(sys.argv) > 1 and sys.argv[1] in {"help", "--help", "-h"}:
        help_text()
        return

    query = " ".join(sys.argv[1:]).strip()
    if not query:
        print("Usage: weyland-semantic-search <query>")
        sys.exit(1)

    model = SentenceTransformer(MODEL_NAME)
    embedding = model.encode(query, normalize_embeddings=True)
    vector = "[" + ",".join(str(float(x)) for x in embedding) + "]"

    conn = psycopg2.connect(
        host="localhost",
        dbname="weyland",
        user="weyland",
        password="weyland_dev_password",
        port=5432,
    )

    with conn:
        with conn.cursor() as cur:
            cur.execute("""
                SELECT
                  d.name,
                  c.chunk_index,
                  1 - (c.embedding <=> %s::vector) AS similarity,
                  c.content
                FROM rag_chunks c
                JOIN rag_documents d ON d.id = c.document_id
                WHERE c.embedding IS NOT NULL
                ORDER BY c.embedding <=> %s::vector
                LIMIT 5;
            """, (vector, vector))

            for name, idx, score, content in cur.fetchall():
                print(f"SOURCE: {name} | CHUNK: {idx} | SCORE: {score:.4f}")
                print(content)
                print()

    conn.close()

if __name__ == "__main__":
    main()
