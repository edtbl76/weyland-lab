meta {
  name: context-search
  type: http
  seq: 11
}

post {
  url: {{ts}}/context/search?backend=qdrant
  body: json
  auth: none
}

params:query {
  backend: qdrant
}

body:json {
  {
    "query": "health datasets",
    "top_k": 2
  }
}

assert {
  res.status: eq 200
  res.body.query: eq health datasets
  res.body.results: isArray
}

docs {
  A real functional request (not just health): vector retrieval over the qdrant backend via the
  tool-server's `/context/search`. Read-only (retrieval, no writes) and passes the B14 input guard
  (fail-open). Swap `backend` to pgvector | weaviate | neo4j to exercise the other stores.
}
